# Copia este archivo como web/.env.local SOLO si quieres cambiar algo. Nunca pongas claves aquí.

# Modelo de Gemini (revisa los vigentes en Google AI Studio).
VITE_GEMINI_MODEL=gemini-flash-lite-latest

# Dirección de tu intermediario en Cloudflare (no es secreta). Vacío = se pone en Ajustes.
VITE_WORKER_URL=

# --- Secretos del intermediario: NO van en archivos. Se cargan en Cloudflare con:
#   cd worker && npx wrangler secret put GEMINI_API_KEY
#   cd worker && npx wrangler secret put ACCESS_TOKEN
